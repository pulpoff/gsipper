#!/bin/sh
# postinst: refresh icon / desktop caches, hint about pjsua2 + extension.
set -e

case "$1" in
configure)
    # Hicolor icon-theme cache so the launcher icon appears
    # immediately in the app grid / dock without a relogin.
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache --quiet --ignore-theme-index \
            /usr/share/icons/hicolor 2>/dev/null || true
    fi
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database --quiet /usr/share/applications \
            2>/dev/null || true
    fi
    if command -v glib-compile-schemas >/dev/null 2>&1; then
        glib-compile-schemas /usr/share/glib-2.0/schemas \
            2>/dev/null || true
    fi

    # The deb may bundle pjsua2 under /usr/lib/gsipper; let the same
    # check that gsipper itself uses at runtime decide. Capture the
    # error message so we can distinguish 'no pjsua2 at all' from
    # 'pjsua2 there but a runtime lib is missing' (most often
    # libbcg729 for G.729, which is now a Recommends rather than a
    # Depends so apt won't refuse to install gsipper if it's absent).
    pjsua2_error="$(python3 -c "
import sys
sys.path.insert(0, '/usr/lib/gsipper')
import pjsua2  # noqa
" 2>&1 >/dev/null || true)"

    if [ -n "$pjsua2_error" ]; then
        case "$pjsua2_error" in
        *libbcg729*)
            cat <<EOF

  NOTE: the PJSUA2 Python bindings need libbcg729 for G.729 support
  and it is not installed. Either install it:

      sudo apt install libbcg729-0

  or rebuild gsipper's pjsua2 without the G.729 codec:

      sudo gsipper --install-pjsua2

EOF
            ;;
        *)
            cat <<EOF

  NOTE: the PJSUA2 Python bindings are not importable
  ($pjsua2_error). gsipper will start but cannot place
  calls until you build them:

      sudo gsipper --install-pjsua2

  (one-time, ~5 min, ~150 MB cache under ~/.cache/gsipper).

EOF
            ;;
        esac
    fi

    cat <<EOF
  The GNOME-Shell status-bar extension is installed system-wide at:
      /usr/share/gnome-shell/extensions/gsipper@pulpoff.com

  Enable it via the Extensions application, or:
      gnome-extensions enable gsipper@pulpoff.com

  Restart GNOME Shell to pick up the new extension list:
      - X11   : Alt+F2, type 'r', Enter
      - Wayland: log out and back in

EOF
    ;;
esac

#DEBHELPER#
exit 0
